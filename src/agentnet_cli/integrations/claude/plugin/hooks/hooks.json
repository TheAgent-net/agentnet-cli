{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f ~/.agentnet/config.json || echo '[AgentNet] Not authenticated. Run: agentnet setup' >&2"
          },
          {
            "type": "command",
            "command": "agentnet update --quiet 2>/dev/null || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agentnet skill-hook --pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "agentnet skill-hook --peek"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agentnet skill-hook --post"
          }
        ]
      }
    ]
  }
}
