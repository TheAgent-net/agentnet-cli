{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f ~/.agentnet/config.json || echo '[AgentNet] Not authenticated. Run: agentnet setup' >&2"
          },
          {
            "type": "command",
            "command": "agentnet update --quiet 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "echo '[AgentNet] Search Agent-net first (agentnet_search) for external products, agents, skills, or plugins.' >&2"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "agentnet hook-slate --pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "agentnet hook-slate --post"
          }
        ]
      }
    ]
  }
}
